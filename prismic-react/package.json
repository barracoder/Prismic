{
  "name": "prismic-react-workspace",
  "version": "1.0.0",
  "description": "Workspace for prismic-react library and demo website",
  "private": true,
  "workspaces": [
    "packages/prismic-react",
    "packages/demo-website"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w packages/prismic-react && npm run build -w packages/demo-website",
    "test": "npm run test -w packages/prismic-react",
    "test:watch": "npm run test:watch -w packages/prismic-react",
    "test:coverage": "npm run test:coverage -w packages/prismic-react",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "dev": "npm run dev -w packages/demo-website",
    "lint": "npm run lint -w packages/prismic-react && npm run lint -w packages/demo-website",
    "typecheck": "npm run typecheck -w packages/prismic-react",
    "preview": "npm run preview -w packages/demo-website",
    "clean": "rm -rf packages/*/dist packages/*/coverage packages/*/node_modules"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
